# Copy to .env and fill the values. NEVER commit .env.

# --- App ---
APP_ENV=dev                      # dev | test | prod
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Host names the app answers to (comma separated) - REQUIRED in prod, e.g. app.codconfirm.tn
ALLOWED_HOSTS=*
# Key(s) used to encrypt shop secrets at rest (required in prod). Rotation: "new,old".
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Production stack (docker-compose.prod.yml) ---
DOMAIN=app.example.tn
ACME_EMAIL=you@example.tn
POSTGRES_PASSWORD=change-me-long-random
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14

# --- Monitoring ---
# Errors are pushed to this Telegram chat (uses TELEGRAM_BOT_TOKEN)
OPERATOR_TELEGRAM_CHAT_ID=
# Optional Sentry (pip install sentry-sdk)
SENTRY_DSN=

# --- Database ---
# Local dev (SQLite) :
DATABASE_URL=sqlite:///./cod_confirm.db
# Production (PostgreSQL) :
# DATABASE_URL=postgresql+psycopg://cod:password@db:5432/cod_confirm

# --- WhatsApp Cloud API (Meta) ---
# true = messages are logged, never sent to Meta (no credentials needed)
DRY_RUN=true
META_GRAPH_API_VERSION=v21.0
META_APP_SECRET=
META_VERIFY_TOKEN=
# Meta has no Darija language code; Latin Darija templates are registered under:
WHATSAPP_DARIJA_TEMPLATE_LANGUAGE=fr

# --- Conversation ---
MAX_CLARIFICATIONS=2
# Owner alerts (Telegram bot from @BotFather)
TELEGRAM_BOT_TOKEN=
# Optional LLM fallback for intent detection (pip install -r requirements-llm.txt)
INTENT_LLM_ENABLED=false
ANTHROPIC_API_KEY=
INTENT_LLM_MODEL=claude-opus-5-5

# --- Self-service sign-up ---
SIGNUP_ENABLED=true
# URL of your terms of service (adds a mandatory checkbox at sign-up)
TERMS_URL=

# --- Subscription payments (Konnect / Flouci) ---
# Public https URL of the app (payment return + webhook URLs). Required with real providers.
PUBLIC_BASE_URL=
# Konnect: dashboard.konnect.network -> API key + wallet id. Sandbox until you go live.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_SANDBOX=true
# Flouci: developers portal -> app public / private keys
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
# Demo checkout without real money (ignored in prod)
PAYMENTS_DEMO=true
TRIAL_DAYS=14
BILLING_GRACE_DAYS=3

# --- Google Sheets sync (optional): service-account JSON key ---
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Scheduler (enable on ONE instance only) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
QUIET_HOURS_START=22
QUIET_HOURS_END=8
NO_ANSWER_AFTER_HOURS=24
DAILY_SUMMARY_HOUR=21
MAX_SEND_FAILURES=3

# --- Defaults ---
DEFAULT_TIMEZONE=Africa/Tunis
DEFAULT_LANGUAGE=darija          # darija | ar | fr
DEFAULT_CURRENCY=TND

# AI voice call in Darija for orders unanswered on WhatsApp (see docs/voice-agent.md)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_TELEPHONY=twilio
ELEVENLABS_WEBHOOK_SECRET=
