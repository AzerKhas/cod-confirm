# Copy to .env and fill the values. NEVER commit .env.

# --- App ---
APP_ENV=dev                      # dev | test | prod
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Key used to encrypt shop tokens at rest (required in prod):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Database ---
# Local dev (SQLite) :
DATABASE_URL=sqlite:///./cod_confirm.db
# Production (PostgreSQL) :
# DATABASE_URL=postgresql+psycopg://cod:password@db:5432/cod_confirm

# --- WhatsApp Cloud API (Meta) ---
# true = messages are logged, never sent to Meta (no credentials needed)
DRY_RUN=true
META_GRAPH_API_VERSION=v21.0
META_APP_SECRET=
META_VERIFY_TOKEN=
# Meta has no Darija language code; Latin Darija templates are registered under:
WHATSAPP_DARIJA_TEMPLATE_LANGUAGE=fr

# --- Defaults ---
DEFAULT_TIMEZONE=Africa/Tunis
DEFAULT_LANGUAGE=darija          # darija | ar | fr
DEFAULT_CURRENCY=TND
