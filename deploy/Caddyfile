# Caddy gets and renews the HTTPS certificate automatically (Let's Encrypt).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 2MB
	}

	# The app sets its own security headers; hide the proxy's identity.
	header -Server

	reverse_proxy app:8000 {
		health_uri /health
		health_interval 30s
	}

	log {
		output stdout
		format json
	}
}
